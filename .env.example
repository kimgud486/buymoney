# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_API_KEY: Firebase Web API key provided via environment variable
VITE_FIREBASE_API_KEY=

# KIS LIVE ACCOUNT RUNTIME
# Required for KIS real-time market/account/order integration.
# Store real values only in the deployment secret/environment manager. Never commit them.
KIS_APPKEY=
KIS_APPSECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD="01"

# Optional override. Production defaults to Korea Investment & Securities real REST domain.
KIS_REAL_DOMAIN="https://openapi.koreainvestment.com:9443"
